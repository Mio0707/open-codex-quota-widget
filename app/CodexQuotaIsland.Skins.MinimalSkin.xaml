<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CodexQuotaIsland.Skins.MinimalSkin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skins="clr-namespace:CodexQuotaIsland.Skins;assembly=Codex额度悬浮窗" Width="356" Height="92">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <LinearGradientBrush x:Key="ProgressBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A99BFF" Offset="0" />
        <GradientStop Color="#F0A8D3" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Margin="8" CornerRadius="24" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
    <Grid Margin="18,13,106,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="52" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Name="PercentageText" Text="--" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="%" Margin="1,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" />
      </StackPanel>
      <Grid Column="1" Margin="8,5,0,3">
        <Grid.RowDefinitions>
          <RowDefinition Height="9" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Height="6" CornerRadius="3" Background="{DynamicResource TrackBackgroundBrush}">
          <Grid ClipToBounds="True">
            <Border Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource ProgressBrush}" />
          </Grid>
        </Border>
        <TextBlock Name="ResetText" Grid.Row="1" Text="正在读取额度…" Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="10" />
      </Grid>
    </Grid>
  </Border>
</UserControl>