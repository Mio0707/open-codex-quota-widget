<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CodexQuotaIsland.Skins.IncenseSkin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skins="clr-namespace:CodexQuotaIsland.Skins;assembly=Codex额度悬浮窗" Width="176" Height="386">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="SmokeAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetName="SmokeOne" Storyboard.TargetProperty="Opacity" From="0.08" To="0.42" Duration="0:0:3.6" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="SmokeTwo" Storyboard.TargetProperty="Opacity" From="0.34" To="0.03" Duration="0:0:4.3" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="SmokeThree" Storyboard.TargetProperty="Opacity" From="0.02" To="0.28" Duration="0:0:5.1" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="SmokeDrift" Storyboard.TargetProperty="X" From="-3" To="4" Duration="0:0:4.8" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="SmokeDrift" Storyboard.TargetProperty="Y" From="5" To="-7" Duration="0:0:5.8" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="EmberGlow" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:1.15" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="EmberHalo" Storyboard.TargetProperty="Opacity" From="0.32" To="0.72" Duration="0:0:1.55" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="SparkOne" Storyboard.TargetProperty="Opacity" From="0" To="0.75" Duration="0:0:1.7" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="SparkOneRise" Storyboard.TargetProperty="Y" From="2" To="-18" Duration="0:0:3.4" />
        <DoubleAnimation Storyboard.TargetName="SparkTwo" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.2" From="0" To="0.5" Duration="0:0:2.1" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="SparkTwoRise" Storyboard.TargetProperty="Y" BeginTime="0:0:1.2" From="1" To="-14" Duration="0:0:4.2" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Margin="8" CornerRadius="30" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
    <Grid Margin="14,12,14,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="238" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Canvas Grid.Row="1" Width="112" Height="232" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Canvas Name="SmokeGroup" Width="80" Height="72" Left="16" Top="0" IsHitTestVisible="False">
          <UIElement.RenderTransform>
            <TranslateTransform x:Name="SmokeDrift" />
          </UIElement.RenderTransform>
          <Path Name="SmokeOne" Stroke="#D8D5D8" StrokeThickness="1.15" Opacity="0.35" Data="M41,70 C29,59 54,50 42,37 C32,26 49,18 44,1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          <Path Name="SmokeTwo" Stroke="#A49FA5" StrokeThickness="0.9" Opacity="0.22" Data="M48,70 C61,56 38,48 51,33 C62,20 49,13 55,0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          <Path Name="SmokeThree" Stroke="#706C72" StrokeThickness="0.7" Opacity="0.16" Data="M38,69 C45,60 36,54 41,46 C48,35 35,29 39,18 C42,10 37,6 40,0" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <UIElement.Effect>
              <BlurEffect Radius="0.8" />
            </UIElement.Effect>
          </Path>
        </Canvas>
        <Border Name="IncenseStick" Canvas.Left="52" Canvas.Top="70" Width="8" Height="135" CornerRadius="4,4,2,2">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#3C201B" Offset="0" />
              <GradientStop Color="#7B4635" Offset="0.22" />
              <GradientStop Color="#A26145" Offset="0.48" />
              <GradientStop Color="#6A392D" Offset="0.76" />
              <GradientStop Color="#321B18" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <UIElement.Effect>
            <DropShadowEffect Color="#120C09" BlurRadius="4" ShadowDepth="2" Opacity="0.7" />
          </UIElement.Effect>
          <Grid ClipToBounds="True">
            <Rectangle Width="1" HorizontalAlignment="Left" Margin="2,0,0,0" Fill="#20E4A47C" />
            <Rectangle Width="1" HorizontalAlignment="Right" Margin="0,0,1,0" Fill="#38201018" />
          </Grid>
        </Border>
        <Ellipse Name="EmberHalo" Canvas.Left="47" Canvas.Top="64" Width="18" Height="18" Fill="#5CFF4A1F" IsHitTestVisible="False">
          <UIElement.Effect>
            <BlurEffect Radius="8" />
          </UIElement.Effect>
        </Ellipse>
        <Border Name="EmberGlow" Canvas.Left="50.5" Canvas.Top="68" Width="11" Height="5" CornerRadius="3" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#FFE4A0" Offset="0" />
              <GradientStop Color="#FF6A2A" Offset="0.4" />
              <GradientStop Color="#8C2118" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <UIElement.Effect>
            <DropShadowEffect Color="#FF4F21" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
          </UIElement.Effect>
        </Border>
        <Border Name="AshCap" Canvas.Left="51.5" Canvas.Top="63" Width="9" Height="8" CornerRadius="4,4,1,1" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#686368" Offset="0" />
              <GradientStop Color="#C2BCB7" Offset="0.45" />
              <GradientStop Color="#777277" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Ellipse Name="SparkOne" Canvas.Left="47" Canvas.Top="62" Width="2.2" Height="2.2" Fill="#FF8A46">
          <UIElement.RenderTransform>
            <TranslateTransform x:Name="SparkOneRise" />
          </UIElement.RenderTransform>
        </Ellipse>
        <Ellipse Name="SparkTwo" Canvas.Left="64" Canvas.Top="65" Width="1.5" Height="1.5" Fill="#FFB071">
          <UIElement.RenderTransform>
            <TranslateTransform x:Name="SparkTwoRise" />
          </UIElement.RenderTransform>
        </Ellipse>
        <Path Canvas.Left="15" Canvas.Top="205" Fill="#29272A" Data="M4,8 C22,18 60,18 80,8 L75,17 C54,26 26,26 9,17" />
        <Ellipse Canvas.Left="17" Canvas.Top="207" Width="78" Height="14" Fill="#353237" Stroke="#4A464C" StrokeThickness="1" />
        <Ellipse Canvas.Left="24" Canvas.Top="210" Width="9" Height="2.5" Fill="#6D696B" Opacity="0.65" />
        <Ellipse Canvas.Left="61" Canvas.Top="213" Width="13" Height="2" Fill="#777274" Opacity="0.42" />
        <Ellipse Canvas.Left="34" Canvas.Top="215" Width="5" Height="1.5" Fill="#959092" Opacity="0.48" />
        <Ellipse Canvas.Left="52" Canvas.Top="211" Width="8" Height="4" Fill="#171618" />
      </Canvas>
      <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Name="PercentageText" Text="--" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Display" FontSize="31" FontWeight="SemiBold" />
          <TextBlock Text="%" Margin="2,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Name="ResetText" Text="正在读取额度…" Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="10" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Border>
  <FrameworkElement.Triggers>
    <EventTrigger RoutedEvent="UserControl.Loaded">
      <BeginStoryboard Storyboard="{StaticResource SmokeAnimation}" />
    </EventTrigger>
  </FrameworkElement.Triggers>
</UserControl>