<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CodexQuotaIsland.Skins.CatYarnSkin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skins="clr-namespace:CodexQuotaIsland.Skins;assembly=Codex额度悬浮窗" Width="480" Height="250">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="CatIdleAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetName="CatBob" Storyboard.TargetProperty="Y" From="-1.5" To="2" Duration="0:0:0.72" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="BallBob" Storyboard.TargetProperty="Y" From="0" To="-2.5" Duration="0:0:0.58" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="DustOne" Storyboard.TargetProperty="Opacity" From="0.08" To="0.45" Duration="0:0:1.4" AutoReverse="True" />
        <DoubleAnimation Storyboard.TargetName="DustTwo" Storyboard.TargetProperty="Opacity" From="0.38" To="0.04" Duration="0:0:1.9" AutoReverse="True" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Margin="8" CornerRadius="28" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
    <Grid ClipToBounds="True">
      <Ellipse Width="230" Height="90" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-35,-52" Fill="#183C284A" />
      <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="34" />
          <RowDefinition Height="132" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Canvas Name="TrackCanvas" Grid.Row="1" Width="452" Height="132" HorizontalAlignment="Center" ClipToBounds="True">
          <Border Canvas.Left="14" Canvas.Top="112" Width="424" Height="6" CornerRadius="3" Background="{DynamicResource TrackBackgroundBrush}" />
          <Border Name="JourneyProgress" Canvas.Left="14" Canvas.Top="112" Width="0" Height="6" CornerRadius="3">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#775A80" Offset="0" />
                <GradientStop Color="#C06E9B" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Ellipse Canvas.Left="12" Canvas.Top="110" Width="10" Height="10" Fill="#564B59" />
          <Ellipse Canvas.Left="432" Canvas.Top="110" Width="10" Height="10" Fill="#3C363F" />
          <Image Name="CatImage" Width="150" Height="100" Canvas.Left="18" Canvas.Top="12" Source="/Assets/shengsheng-push.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
            <UIElement.RenderTransform>
              <TranslateTransform x:Name="CatBob" />
            </UIElement.RenderTransform>
          </Image>
          <Canvas Name="YarnBallGroup" Width="34" Height="34" Left="174" Top="79">
            <UIElement.RenderTransform>
              <TransformGroup>
                <RotateTransform x:Name="BallRotation" CenterX="17" CenterY="17" />
                <TranslateTransform x:Name="BallBob" />
              </TransformGroup>
            </UIElement.RenderTransform>
            <Viewbox Width="34" Height="34" Stretch="Uniform">
              <Canvas Width="50" Height="42">
                <Ellipse Width="38" Height="38" Canvas.Left="2" Canvas.Top="2">
                  <Shape.Fill>
                    <RadialGradientBrush GradientOrigin="0.33,0.28">
                      <GradientStop Color="#E8A7C8" Offset="0" />
                      <GradientStop Color="#B95C8B" Offset="0.55" />
                      <GradientStop Color="#733451" Offset="1" />
                    </RadialGradientBrush>
                  </Shape.Fill>
                </Ellipse>
                <Path Data="M7,12 C16,7 28,8 35,14 M5,22 C15,17 29,18 38,24 M9,31 C18,26 29,27 35,33" Stroke="#F1C2D8" StrokeThickness="1.2" Opacity="0.65" />
                <Path Data="M12,5 C18,14 23,26 25,38 M26,4 C20,14 17,27 17,38" Stroke="#8E4166" StrokeThickness="1" Opacity="0.8" />
                <Path Data="M36,32 C42,34 44,38 49,37" Stroke="#C66F9B" StrokeThickness="1.5" StrokeStartLineCap="Round" />
              </Canvas>
            </Viewbox>
          </Canvas>
          <Ellipse Name="DustOne" Canvas.Left="25" Canvas.Top="105" Width="5" Height="3" Fill="#655D68" Opacity="0.25" />
          <Ellipse Name="DustTwo" Canvas.Left="34" Canvas.Top="108" Width="3" Height="2" Fill="#655D68" Opacity="0.18" />
        </Canvas>
        <Grid Row="2" Margin="10,5,96,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Name="PercentageText" Text="--" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="%" Margin="2,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
          </StackPanel>
          <TextBlock Name="ResetText" Text="正在读取额度…" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="10" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
  <FrameworkElement.Triggers>
    <EventTrigger RoutedEvent="UserControl.Loaded">
      <BeginStoryboard Storyboard="{StaticResource CatIdleAnimation}" />
    </EventTrigger>
  </FrameworkElement.Triggers>
</UserControl>