<Window x:Class="OpenCodexQuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota Widget" Width="340" Height="174" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="True"
        Background="#171B24" Foreground="White">
  <Border Padding="18" BorderBrush="#4C78FF" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="28" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold" Foreground="#B9C7FF">Codex 可用额度</TextBlock>
      <Button Grid.Row="0" Grid.Column="1" Content="×" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Foreground="#D9E1FF" FontSize="20" FontWeight="Light" Cursor="Hand" />
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
        <TextBlock x:Name="RemainingText" FontSize="42" FontWeight="Bold" />
        <TextBlock x:Name="ResetText" Margin="0,5,0,0" FontSize="13" Foreground="#C5CCDB" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock x:Name="UpdatedText" Grid.Row="2" Grid.ColumnSpan="2" FontSize="11" Foreground="#8992A5" />
    </Grid>
  </Border>
</Window>

